<Window x:Class="pdfdir_win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:collections="clr-namespace:System.Collections.ObjectModel;assembly=PresentationCore"
        xmlns:local="clr-namespace:pdfdir_win"
        mc:Ignorable="d"
        Title="MainWindow" Height="515" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左侧区域 -->
            <ColumnDefinition Width="79*"/>
            <ColumnDefinition Width="221*"/>
            <!-- 分隔线 -->
            <ColumnDefinition Width="Auto"/>
            <!-- 右侧区域 -->
            <ColumnDefinition Width="300*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧内容 -->
        <Border Grid.Column="0" Margin="5,5,6,5" Grid.ColumnSpan="2">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 第一行：水平排列的按钮和文本 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="选择文件" 
                            Width="80" 
                            Height="30"
                            Click="SelectFileButton_Click"/>
                    <TextBlock Text="文件名" 
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"/>
                    <TextBlock x:Name="FilePathText" 
                            Text="{Binding FileName}" 
                            VerticalAlignment="Center"
                            Margin="5,0,0,0"/>
                </StackPanel>

                <!-- 第二行：提示文字、文本框和写入按钮 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 提示文字 -->
                    <TextBlock Grid.Row="0" 
                            Text="目录文本" 
                            FontWeight="Bold"
                            Margin="0,0,0,5"/>

                    <!-- 文本框 -->
                    <TextBox Grid.Row="1"
                            Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                            x:Name="InputTextBox"
                            Margin="0,0,0,10"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            MaxHeight="500"/>

                    <!-- 第三行：多选框和按钮紧挨着 -->
                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="页差" 
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="0,0,3,5"/>
                        <xctk:IntegerUpDown x:Name="NumberInput"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                Width="100"
                                Height="30" Margin="0,0,5,0"/>
                        <CheckBox x:Name="EnableCheckBox"
                                Content="写入原文件"
                                IsChecked="True"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"/>

                        <!-- 写入按钮 -->
                        <Button x:Name="WriteButton"
                                Content="写入"
                                Width="80"
                                Height="30"
                                Click="WriteButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 分隔线（可拖动） -->
        <GridSplitter Grid.Column="2" 
                      Width="0" 
                      HorizontalAlignment="Center"
                      Background="#323232"/>

        <!-- 右侧内容 -->
        <Border Grid.Column="3" Margin="6,5,5,5">
            <TreeView ItemsSource="{Binding BookDirectory.Chapters}" 
                Grid.Row="1" Margin="10">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}"/>
                            <TextBlock Text=" (第" Foreground="Gray"/>
                            <TextBlock Text="{Binding PageNumber}" Foreground="Gray"/>
                            <TextBlock Text="页)" Foreground="Gray"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>
    </Grid>
</Window>
